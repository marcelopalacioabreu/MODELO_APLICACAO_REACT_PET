%% Diagram 1: Arquitetura geral (Next.js app router, componentes, contexts, services)
flowchart TB
  subgraph FRONTEND["Next.js 14 - Frontend"]
    subgraph APPDir["src/app"]
      Layout["layout.tsx\nRootLayout"]
      Page["page.tsx\nHomePage"]
      subgraph ROUTES["Rotas (app/)"]
        Home["/ (Home)"]
        Admin["/admin (Área Admin)"]
        Auth["/auth/* (Login, Register, Change PW)"]
      end
    end

    subgraph COMPONENTS["src/components"]
      HomeComp["home/*\n(LandingNavbar, LandingHero, etc.)"]
      AuthComp["auth/*\n(Login forms)"]
      LayoutComp["layout/*\n(Nav, Sidebar)"]
      Modals["modals/*"]
    end

    Contexts["AuthContext.tsx\n(Autenticação, tokens, socket.io)"]
    Services["services/apiService.ts\n(axios wrapper, endpoints)"]
    Utils["utils/*\n(textParser, cpfUtils)"]
    Dependencies["React / Next.js / Tailwind / Framer Motion / Socket.IO client / Recharts / axios / react-hook-form / toast"]
  end

  Page --> HomeComp
  Layout --> Contexts
  Layout --> Services
  Contexts --> Services
  Services --> Backend["Backend API - HTTP + socket.io"]
  Contexts --> Dependencies
  COMPONENTS --> Dependencies

