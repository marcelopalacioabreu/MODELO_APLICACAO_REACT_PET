    AuthAPI["Auth endpoints<br/>/login, /me, /logout"]
    PetsAPI["/pets, /pets/lost, /pets/adoptable"]
    FeedAPI["/feed, /feed/public"]
    AdminAPI["/admin/*<br/>(roles, users, permissions)"]
    InventoryAPI["/inventory/*"]
    AppointmentsAPI["/appointments, /triage"]
  end

  Services --> AuthAPI
  Services --> PetsAPI
  Services --> FeedAPI
  Services --> AdminAPI
  Services --> InventoryAPI
  Services --> AppointmentsAPI

